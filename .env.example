# Google OAuth Client ID for real Google account sign-in.
# Create it in Google Cloud Console as an OAuth 2.0 Web client and add your app domain/origin.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Server-only database URL for the /api/cloud-backup serverless function.
# Store the real value in Vercel environment variables only; never paste it into the browser app or chat.
NEON_DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Public API endpoint used by browser/Android clients for cloud backup.
# Web can use /api/cloud-backup; Android builds need the full deployed Vercel URL.
NEXT_PUBLIC_CLOUD_BACKUP_API_URL=https://YOUR-VERCEL-APP.vercel.app/api/cloud-backup
